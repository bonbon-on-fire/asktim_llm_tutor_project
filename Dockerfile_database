# Stage 1: reduce curriculum/ to just its course_name.txt files (active +
# _archive). database_ui shows course display names but never runs the tutor, so
# it ships only the name files -- not pinned prompts, exercises, or RAG indexes.
# This keeps display names in sync with the single source of truth
# (curriculum/<key>/course_name.txt) with no hand-maintained mirror in code.
FROM python:3.12-slim AS curriculum-names
COPY curriculum/ /curriculum/
RUN find /curriculum -type f ! -name course_name.txt -delete \
    && find /curriculum -depth -type d -empty -delete

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system dependencies (libpq5 for Postgres client)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (database_ui = read-only conversation review dashboard).
# No tutor/ or rag/ — this app never runs the tutor; it only reads the DB. Only
# curriculum/'s course_name.txt files are bundled (from the stage above), so
# database_ui.courses resolves display names without a hardcoded mirror.
# ui_core/ is required: database_ui imports ui_core.db.session and registers the
# shared ui_core static blueprint (serves chat.css at /ui-core/css/chat.css).
COPY database_ui/ database_ui/
COPY ui_core/ ui_core/
COPY --from=curriculum-names /curriculum/ curriculum/
# The Flagged card's (i) icon serves the calibrated grading rubric (markdown);
# analytics.default_rubric() reads it from eval/tutor_judge/rubrics/ — the same
# rubric the judge uses, kept as the single source of truth (not vendored here).
COPY eval/tutor_judge/rubrics/ eval/tutor_judge/rubrics/
COPY scripts/railway-entrypoint-database.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 5003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5003/health', timeout=5)"

ENTRYPOINT ["/entrypoint.sh"]
