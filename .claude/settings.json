{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/guard-api-keys.sh",
            "statusMessage": "Checking for project API-key usage..."
          }
        ]
      }
    ]
  }
}
