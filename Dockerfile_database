FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Install system dependencies (libpq5 for Postgres client)
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (database_ui = read-only conversation review dashboard).
# No tutor/ rag/ curriculum/ — this app never runs the tutor; it only reads the DB.
# ui_core/ is required: database_ui imports ui_core.db.session and registers the
# shared ui_core static blueprint (serves chat.css at /ui-core/css/chat.css).
COPY database_ui/ database_ui/
COPY ui_core/ ui_core/
COPY scripts/railway-entrypoint-database.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 5003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5003/health', timeout=5)"

ENTRYPOINT ["/entrypoint.sh"]
